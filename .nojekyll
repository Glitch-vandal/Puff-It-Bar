:root {
  --bg: #08111d;
  --bg-2: #0e1b2d;
  --panel: rgba(17, 27, 42, 0.8);
  --panel-strong: #101c2f;
  --card: #16263d;
  --text: #edf4ff;
  --muted: #b4c0d7;
  --gold: #d9b36c;
  --gold-soft: #f1d292;
  --accent: #67d0ff;
  --accent-2: #7de7c0;
  --border: rgba(255, 255, 255, 0.08);
  --shadow: 0 28px 60px rgba(5, 9, 15, 0.42);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(103, 208, 255, 0.12), transparent 26%),
    radial-gradient(circle at bottom right, rgba(125, 231, 192, 0.1), transparent 20%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  color: var(--text);
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

p {
  margin: 0 0 1rem;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
}

.narrow {
  max-width: 760px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(14px);
  background: rgba(8, 17, 29, 0.72);
  border-bottom: 1px solid var(--border);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 74px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  font-weight: 700;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--gold), var(--gold-soft));
  color: #0d1625;
  letter-spacing: 0.12em;
  font-size: 0.9rem;
  box-shadow: var(--shadow);
}

.brand-text {
  font-size: 1rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

nav {
  display: flex;
  gap: 1.2rem;
  flex-wrap: wrap;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s ease;
}

nav a:hover {
  color: var(--text);
}

.hero {
  padding: 88px 0 46px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.18fr 0.82fr;
  gap: 2.5rem;
  align-items: center;
}

.eyebrow,
.section-label {
  display: inline-block;
  margin-bottom: 0.9rem;
  font-size: 0.76rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--gold-soft);
  font-weight: 700;
}

.hero-copy h1 {
  margin: 0 0 1rem;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.05em;
}

.hero-copy p {
  max-width: 62ch;
  font-size: 1.06rem;
  color: var(--muted);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin: 1.5rem 0 2rem;
}

.stats div {
  padding: 1rem;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.stats strong {
  display: block;
  color: var(--text);
  font-size: 1.1rem;
  margin-bottom: 0.15rem;
}

.stats span {
  color: var(--muted);
  font-size: 0.82rem;
}

.cta-row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.95rem 1.5rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button.primary {
  background: linear-gradient(135deg, var(--gold), var(--gold-soft));
  color: #111827;
  box-shadow: 0 16px 30px rgba(217, 179, 108, 0.28);
}

.button.secondary {
  border: 1px solid var(--border);
  color: var(--text);
  background: rgba(255, 255, 255, 0.02);
}

.hero-visual {
  position: relative;
  background: linear-gradient(180deg, rgba(20, 34, 52, 0.9), rgba(11, 20, 31, 0.8));
  border: 1px solid var(--border);
  border-radius: 28px;
  padding: 1rem;
  box-shadow: var(--shadow);
}

.visual-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 1;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  background: rgba(8, 17, 29, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--gold-soft);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-visual img {
  border-radius: 18px;
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.section {
  padding: 76px 0;
}

.alt {
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.section h2 {
  margin: 0 0 1rem;
  font-size: clamp(2rem, 4vw, 2.9rem);
  line-height: 1.12;
  letter-spacing: -0.04em;
}

.narrow p,
.feature p {
  color: var(--muted);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.feature {
  background: linear-gradient(180deg, rgba(19, 31, 47, 0.9), rgba(16, 28, 47, 0.95));
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 1.6rem 1.4rem;
  box-shadow: 0 20px 40px rgba(4, 8, 15, 0.2);
}

.feature-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  margin-bottom: 1rem;
  background: rgba(103, 208, 255, 0.12);
  color: var(--accent);
  font-weight: 700;
}

.feature h3 {
  margin: 0 0 0.55rem;
  font-size: 1.28rem;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  margin-top: 1.5rem;
}

.gallery-grid img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 18px;
  border: 1px solid var(--border);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.gallery-grid img:hover {
  transform: translateY(-2px);
  border-color: rgba(103, 208, 255, 0.45);
}

.cta-panel {
  padding-bottom: 92px;
}

.center {
  text-align: center;
}

.footer {
  border-top: 1px solid var(--border);
  background: rgba(6, 12, 20, 0.72);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 1.25rem 0;
  color: var(--muted);
}

@media (max-width: 840px) {
  .hero-grid,
  .feature-grid,
  .gallery-grid,
  .stats {
    grid-template-columns: 1fr;
  }

  .nav {
    min-height: 62px;
  }

  nav {
    display: none;
  }

  .hero {
    padding-top: 52px;
  }
}

@media (max-width: 520px) {
  .button {
    width: 100%;
  }

  .cta-row {
    display: grid;
    grid-template-columns: 1fr;
  }
}
