:root {
  --bg: #050b14;
  --bg-2: #0a1322;
  --bg-3: #101d31;
  --panel: rgba(16, 22, 34, 0.82);
  --panel-strong: rgba(12, 17, 28, 0.96);
  --text: #ebf7ff;
  --muted: #a8bfd7;
  --cyan: #5de7ff;
  --cyan-2: #77ffd1;
  --pink: #ff4fd8;
  --gold: #f7d76a;
  --border: rgba(93, 231, 255, 0.25);
  --shadow: 0 0 24px rgba(93, 231, 255, 0.25), 0 24px 60px rgba(0, 0, 0, 0.45);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(93, 231, 255, 0.15), transparent 28%),
    radial-gradient(circle at bottom right, rgba(255, 79, 216, 0.12), transparent 30%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 34%, var(--bg-3) 100%);
  color: var(--text);
  line-height: 1.6;
  overflow-x: hidden;
}

.noise {
  position: fixed;
  inset: 0;
  background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 18px 18px;
  mask-image: radial-gradient(circle at center, black 55%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

img {
  max-width: 100%;
  display: block;
}

p {
  margin: 0 0 1rem;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.narrow {
  max-width: 760px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(18px);
  background: rgba(5, 11, 20, 0.68);
  border-bottom: 1px solid var(--border);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 74px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  font-weight: 700;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--cyan), var(--pink));
  color: #07111a;
  letter-spacing: 0.12em;
  font-size: 0.85rem;
  box-shadow: var(--shadow);
}

.brand-text {
  font-size: 0.82rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

nav {
  display: flex;
  gap: 1.25rem;
  flex-wrap: wrap;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.72rem;
  transition: color 0.2s ease, text-shadow 0.2s ease;
}

nav a:hover {
  color: var(--cyan);
  text-shadow: 0 0 16px rgba(93, 231, 255, 0.7);
}

.hero {
  padding: 88px 0 46px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.18fr 0.82fr;
  gap: 2.5rem;
  align-items: center;
}

.eyebrow,
.section-label {
  display: inline-block;
  margin-bottom: 0.9rem;
  font-size: 0.72rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--cyan);
  font-weight: 700;
  text-shadow: 0 0 18px rgba(93, 231, 255, 0.6);
}

.hero-copy h1 {
  margin: 0 0 1rem;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.94;
  letter-spacing: -0.06em;
  text-transform: uppercase;
}

.hero-copy p {
  max-width: 62ch;
  font-size: 1.06rem;
  color: var(--muted);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin: 1.6rem 0 2rem;
}

.stats div {
  padding: 1rem;
  background: rgba(9, 16, 24, 0.7);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: inset 0 0 0 1px rgba(93, 231, 255, 0.08);
}

.stats strong {
  display: block;
  color: var(--text);
  font-size: 1.08rem;
  margin-bottom: 0.18rem;
}

.stats span {
  color: var(--muted);
  font-size: 0.76rem;
  letter-spacing: 0.04em;
}

.cta-row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.95rem 1.6rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button.primary {
  background: linear-gradient(135deg, var(--cyan), var(--cyan-2));
  color: #07141d;
  box-shadow: 0 0 22px rgba(93, 231, 255, 0.45);
}

.button.secondary {
  border: 1px solid var(--border);
  color: var(--text);
  background: rgba(11, 16, 27, 0.7);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
}

.hero-visual {
  position: relative;
  background: linear-gradient(180deg, rgba(18, 26, 38, 0.9), rgba(10, 15, 24, 0.9));
  border: 1px solid var(--border);
  border-radius: 28px;
  padding: 1rem;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.visual-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 1;
  padding: 0.52rem 0.8rem;
  border-radius: 999px;
  background: rgba(7, 13, 20, 0.72);
  border: 1px solid rgba(93, 231, 255, 0.28);
  color: var(--cyan);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.hero-visual img {
  border-radius: 18px;
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border: 1px solid rgba(100, 238, 255, 0.18);
}

.scanlines {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    180deg,
    rgba(255,255,255,0.05),
    rgba(255,255,255,0.05) 1px,
    transparent 1px,
    transparent 4px
  );
  pointer-events: none;
}

.section {
  padding: 76px 0;
}

.alt {
  background: rgba(255,255,255,0.015);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.section h2 {
  margin: 0 0 1rem;
  font-size: clamp(2rem, 4vw, 2.9rem);
  line-height: 1.08;
  letter-spacing: -0.04em;
  text-transform: uppercase;
}

.narrow p,
.feature p {
  color: var(--muted);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.feature {
  background: linear-gradient(180deg, rgba(16, 24, 35, 0.9), rgba(10, 16, 25, 0.96));
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 1.6rem 1.4rem;
  box-shadow: inset 0 0 0 1px rgba(93, 231, 255, 0.05), 0 20px 40px rgba(0, 0, 0, 0.25);
}

.feature-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  margin-bottom: 1rem;
  background: rgba(93, 231, 255, 0.1);
  color: var(--cyan);
  font-weight: 700;
  box-shadow: 0 0 18px rgba(93, 231, 255, 0.18);
}

.feature h3 {
  margin: 0 0 0.55rem;
  font-size: 1.28rem;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  margin-top: 1.5rem;
}

.gallery-grid img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 18px;
  border: 1px solid var(--border);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 0 12px rgba(93, 231, 255, 0.1);
}

.gallery-grid img:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 18px rgba(93, 231, 255, 0.2);
}

.cta-panel {
  padding-bottom: 92px;
}

.center {
  text-align: center;
}

.footer {
  border-top: 1px solid var(--border);
  background: rgba(4, 9, 15, 0.78);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 1.25rem 0;
  color: var(--muted);
}

@media (max-width: 840px) {
  .hero-grid,
  .feature-grid,
  .gallery-grid,
  .stats {
    grid-template-columns: 1fr;
  }

  .nav {
    min-height: 62px;
  }

  nav {
    display: none;
  }

  .hero {
    padding-top: 52px;
  }
}

@media (max-width: 520px) {
  .button {
    width: 100%;
  }

  .cta-row {
    display: grid;
    grid-template-columns: 1fr;
  }
}
